<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>URL Shorter</title>
    <link rel="stylesheet" href="./style.css">
</head>

<body>
    <div class="container">
        <main>
            <h1>Short URL Generator</h1>

            <div class="form-cont">
                <form method="POST" action="/url">
                    <label for="inputURL">Enter your original URL : </label>
                    <input type="text" name="url" id="inputURL" placeholder="http://example">
                    <button type="submit">Generate</button>
                </form>
            </div>

            <div class="url-cont">
                <% if (locals.id) { %>
                    <h3>
                        URL Generated : http://localhost:5000/<%= id %>
                    </h3>
                    <% } %>
            </div>

            <div class="table-cont">
                <% if (locals.urls) { %>
                    <table border="2" cellspacing="0">
                        <thead>
                            <tr>
                                <th>S.No</th>
                                <th>ShortId</th>
                                <th>Redirect</th>
                                <th>Clicks</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% urls.forEach((url,index)=>{ %>
                                <tr>
                                    <td>
                                        <%= index+1 %>
                                    </td>
                                    <td>
                                        <%= url.shortId %>
                                    </td>
                                    <td>
                                        <%= url.redirectURL %>
                                    </td>
                                    <td>
                                        <%= url.visitedHistory.length %>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                    <% } %>
            </div>
        </main>
    </div>
</body>

</html>